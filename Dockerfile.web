# Resortify web app (server-rendered). Build from the repository root:
#   docker build -f Dockerfile.web --build-arg VITE_API_BASE_URL=https://api.example.com -t resortify-web .
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# The project's default build targets Cloudflare Workers; this image builds for plain Node instead.
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL NITRO_PRESET=node-server
RUN npx vite build

FROM node:22-slim
ENV NODE_ENV=production PORT=3000 HOST=0.0.0.0
WORKDIR /app
COPY --from=build --chown=node:node /app/.output ./.output
USER node
EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
