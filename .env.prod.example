# Used by docker-compose.prod.yml. Copy to .env.prod. Never commit the filled-in copy.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Public addresses people use in the browser (no trailing slash)
PUBLIC_WEB_URL=https://resortify.example.com
PUBLIC_API_URL=https://api.resortify.example.com
