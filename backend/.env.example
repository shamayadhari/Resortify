# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database (MongoDB) ----
# Local MongoDB (e.g. `docker compose up -d` from the project root):
MONGODB_URI=mongodb://127.0.0.1:27017/resortify
# MongoDB Atlas instead (put the real value only in backend/.env, never in this file or in git):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/resortify?retryWrites=true&w=majority

# ---- Auth ----
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Frontend ----
# Where the interface runs (added to the CORS allow-list).
CLIENT_URL=http://localhost:8080
# Extra allowed browser origins, comma separated. Wildcard subdomains work:
# CORS_ORIGINS=https://my-app.lovable.app,https://*.lovableproject.com
CORS_ORIGINS=
# Number of reverse proxies in front of the API (Render/Railway/Heroku = 1). Keeps rate limits per real client IP.
TRUST_PROXY=0

# ---- Files ----
UPLOAD_DIR=uploads

# ---- Rate limit: sign-up, sign-in and contact requests per IP per 15 minutes ----
RATE_LIMIT_MAX=10
